{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlx-spec-bench.invalid/schemas/v1/record.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "sweep_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^case-[a-f0-9]{24}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}-case-[a-f0-9]{24}-r[0-9]{3}$"
    },
    "repetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "run_order": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "success",
        "failure"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "wall_time_ns": {
      "type": "integer",
      "minimum": 0
    },
    "load_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "warmup_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "quality_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "warmups": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "config": {
      "$ref": "config.json"
    },
    "identities": {
      "type": "object",
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "license": {
                  "type": "string",
                  "minLength": 1
                },
                "artifact_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "tokenizer_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "weight_format": {
                  "enum": [
                    "fp16",
                    "q8",
                    "q6",
                    "q4"
                  ]
                },
                "weight_bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "recipe": {
                  "type": "string",
                  "minLength": 1
                },
                "group_size": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "quantized_modules": {
                  "type": "integer",
                  "minimum": 0
                },
                "retained_fp16_parameters": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                }
              },
              "required": [
                "id",
                "source",
                "revision",
                "license",
                "artifact_sha256",
                "tokenizer_sha256",
                "weight_format",
                "weight_bytes",
                "recipe",
                "group_size",
                "quantized_modules",
                "retained_fp16_parameters"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "draft": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "license": {
                  "type": "string",
                  "minLength": 1
                },
                "artifact_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "tokenizer_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "weight_format": {
                  "enum": [
                    "fp16",
                    "q8",
                    "q6",
                    "q4"
                  ]
                },
                "weight_bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "recipe": {
                  "type": "string",
                  "minLength": 1
                },
                "group_size": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "quantized_modules": {
                  "type": "integer",
                  "minimum": 0
                },
                "retained_fp16_parameters": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                }
              },
              "required": [
                "id",
                "source",
                "revision",
                "license",
                "artifact_sha256",
                "tokenizer_sha256",
                "weight_format",
                "weight_bytes",
                "recipe",
                "group_size",
                "quantized_modules",
                "retained_fp16_parameters"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "suite": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "target",
        "draft",
        "suite",
        "evaluation"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "os_release": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "object",
          "properties": {
            "mlx-spec-bench": {
              "type": "string",
              "minLength": 1
            },
            "mlx": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "mlx-lm": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "transformers": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "mlx-spec-bench",
            "mlx",
            "mlx-lm",
            "transformers"
          ],
          "additionalProperties": false
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "logical_cpus": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "platform",
        "os_release",
        "architecture",
        "device",
        "backend",
        "memory_bytes",
        "python",
        "packages",
        "hostname",
        "logical_cpus"
      ],
      "additionalProperties": false
    },
    "process_memory": {
      "type": "object",
      "properties": {
        "sampling_period_ms": {
          "type": "integer",
          "minimum": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "peak_process_rss_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "peak_process_footprint_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "footprint_samples": {
          "type": "integer",
          "minimum": 0
        },
        "system_available_min_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "system_swap_start_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "system_swap_end_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "system_swap_peak_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "pressure_samples": {
          "type": "object",
          "properties": {
            "normal": {
              "type": "integer",
              "minimum": 0
            },
            "warning": {
              "type": "integer",
              "minimum": 0
            },
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "normal",
            "warning",
            "critical",
            "unknown"
          ],
          "additionalProperties": false
        },
        "pressure_max_consecutive_elevated_samples": {
          "type": "integer",
          "minimum": 0
        },
        "pressure_max_elevated_span_ns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "sampling_period_ms",
        "sample_count",
        "peak_process_rss_bytes",
        "peak_process_footprint_bytes",
        "footprint_samples",
        "system_available_min_bytes",
        "system_swap_start_bytes",
        "system_swap_end_bytes",
        "system_swap_peak_bytes",
        "pressure_samples",
        "pressure_max_consecutive_elevated_samples",
        "pressure_max_elevated_span_ns"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ttft_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "itl_ms_per_token": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "decode_tokens_per_second": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "acceptance": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "perplexity": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "task_score": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "undefined": {
              "type": "object",
              "properties": {
                "ttft_ms": {
                  "enum": [
                    "no_output_tokens"
                  ]
                },
                "itl_ms_per_token": {
                  "enum": [
                    "fewer_than_two_tokens_per_request"
                  ]
                },
                "decode_tokens_per_second": {
                  "enum": [
                    "no_post_first_token_emissions",
                    "zero_decode_span"
                  ]
                },
                "acceptance": {
                  "enum": [
                    "no_draft_proposals"
                  ]
                },
                "perplexity": {
                  "enum": [
                    "quality_disabled",
                    "no_scored_tokens"
                  ]
                },
                "task_score": {
                  "enum": [
                    "quality_disabled",
                    "no_scored_examples"
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "tokens": {
              "type": "object",
              "properties": {
                "input": {
                  "type": "integer",
                  "minimum": 0
                },
                "output": {
                  "type": "integer",
                  "minimum": 0
                },
                "accepted": {
                  "type": "integer",
                  "minimum": 0
                },
                "proposed": {
                  "type": "integer",
                  "minimum": 0
                },
                "corrections": {
                  "type": "integer",
                  "minimum": 0
                },
                "bonus": {
                  "type": "integer",
                  "minimum": 0
                },
                "autoregressive": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "input",
                "output",
                "accepted",
                "proposed",
                "corrections",
                "bonus",
                "autoregressive"
              ],
              "additionalProperties": false
            },
            "observations": {
              "type": "object",
              "properties": {
                "requests": {
                  "type": "integer",
                  "minimum": 0
                },
                "ttft": {
                  "type": "integer",
                  "minimum": 0
                },
                "itl": {
                  "type": "integer",
                  "minimum": 0
                },
                "decode_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "decode_duration_ns": {
                  "type": "integer",
                  "minimum": 0
                },
                "ttft_total_ns": {
                  "type": "integer",
                  "minimum": 0
                },
                "itl_total_ns": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "requests",
                "ttft",
                "itl",
                "decode_tokens",
                "decode_duration_ns",
                "ttft_total_ns",
                "itl_total_ns"
              ],
              "additionalProperties": false
            },
            "generation_ns": {
              "type": "integer",
              "minimum": 0
            },
            "prefill_ns": {
              "type": "integer",
              "minimum": 0
            },
            "mlx_allocator_peak_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "mlx_resident_start_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "kv": {
              "type": "object",
              "properties": {
                "window_tokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "committed_peak_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "working_peak_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "evictions": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "window_tokens",
                "committed_peak_bytes",
                "working_peak_bytes",
                "evictions"
              ],
              "additionalProperties": false
            },
            "quality": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "scored_tokens": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "total_nll": {
                      "type": "number",
                      "minimum": 0
                    },
                    "task_correct": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "task_examples": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "rules": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "scored_tokens",
                    "total_nll",
                    "task_correct",
                    "task_examples",
                    "rules"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "ttft_ms",
            "itl_ms_per_token",
            "decode_tokens_per_second",
            "acceptance",
            "perplexity",
            "task_score",
            "undefined",
            "tokens",
            "observations",
            "generation_ns",
            "prefill_ns",
            "mlx_allocator_peak_bytes",
            "mlx_resident_start_bytes",
            "kv",
            "quality"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "details": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^details/[a-z0-9-]+[.]json$"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "platform",
                "config",
                "preflight",
                "allocation_failure",
                "memory_limit",
                "timeout",
                "worker_exit",
                "interrupted",
                "runtime"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "sweep_id",
    "case_id",
    "run_id",
    "repetition",
    "run_order",
    "status",
    "started_at",
    "wall_time_ns",
    "load_ns",
    "warmup_ns",
    "quality_ns",
    "warmups",
    "config",
    "identities",
    "environment",
    "process_memory",
    "metrics",
    "details",
    "error"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "metrics": {
            "type": "object"
          },
          "details": {
            "type": "string"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "metrics": {
            "type": "null"
          },
          "details": {
            "type": "null"
          },
          "error": {
            "type": "object"
          }
        }
      }
    }
  ]
}
