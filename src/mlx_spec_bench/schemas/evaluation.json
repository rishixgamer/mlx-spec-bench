{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlx-spec-bench.invalid/schemas/v1/evaluation.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "prefix": {
            "type": "string",
            "minLength": 1
          },
          "continuation": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "prefix",
          "continuation"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text",
          "answer"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "license",
    "template",
    "text",
    "tasks"
  ],
  "additionalProperties": false
}
